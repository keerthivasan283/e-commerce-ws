# ==============================================================================
# Thrift Tamilan - Database Configuration (.env)
# ==============================================================================

# Option 1: SQLite (Default - Zero setup, runs directly out of database/thrift_tamilan.sqlite)
# DB_TYPE=sqlite
# SQLITE_PATH=database/thrift_tamilan.sqlite

# Option 2: MySQL / MariaDB (e.g. XAMPP, phpMyAdmin, or remote MySQL)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=thrift_tamilan_db

# Option 3: PostgreSQL / Supabase / Neon
# DB_TYPE=postgres
# DATABASE_URL=postgresql://postgres:password@localhost:5432/thrift_tamilan_db

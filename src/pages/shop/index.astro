---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import FloatingWhatsApp from '../../components/common/FloatingWhatsApp.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import EmptyState from '../../components/shop/EmptyState.astro';
import { getAllProducts } from '../../lib/db';
import type { Product, ProductCategory, ProductSize } from '../../types/product';
import siteConfig from '../../config/site';

const products = getAllProducts();

// Extract distinct categories & sizes for filter dropdowns
const categories: ProductCategory[] = ['T-Shirts', 'Shirts', 'Jackets', 'Jeans', 'Hoodies', 'Trousers'];
const sizes: ProductSize[] = ['S', 'M', 'L', 'XL', 'XXL', '30', '32', '34'];
---

<BaseLayout
  title="Shop Catalogue"
  description="Browse 1-of-1 curated vintage jackets, tees, denim, and streetwear in Tamil Nadu. Filter by size, category, and price. Order directly on WhatsApp."
>
  <Header slot="header" currentPath="/shop" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Breadcrumb & Page Title -->
    <div class="mb-8 border-b border-brand-border pb-6">
      <nav class="flex items-center space-x-2 text-xs font-mono text-brand-charcoal/60 mb-2 uppercase tracking-wider">
        <a href="/" class="hover:text-brand-accent">Home</a>
        <span>/</span>
        <span class="text-brand-dark font-bold">Shop</span>
      </nav>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h1 class="font-display text-4xl sm:text-6xl uppercase tracking-tight text-brand-dark leading-none">
            ARCHIVE CATALOGUE
          </h1>
          <p class="text-sm font-sans text-brand-charcoal/80 mt-2">
            Every piece is 1-of-1. Once sold, it is gone forever. Order directly via WhatsApp.
          </p>
        </div>
        <div class="text-xs font-mono bg-white border border-brand-border px-3.5 py-2 inline-flex items-center gap-2 self-start md:self-auto">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Showing <strong id="visible-count">{products.length}</strong> of {products.length} Pieces</span>
        </div>
      </div>
    </div>

    <!-- Filters & Controls Bar -->
    <div class="bg-white border border-brand-border p-4 md:p-6 mb-8 shadow-sm">
      <div class="flex flex-col gap-4">
        
        <!-- Filter Controls Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3.5">
          
          <!-- Category Filter -->
          <div>
            <label for="filter-category" class="block text-[11px] font-mono uppercase font-bold text-brand-charcoal/80 mb-1">
              Category
            </label>
            <select
              id="filter-category"
              class="w-full text-xs font-mono bg-brand-surface border border-brand-border px-3 py-2.5 focus:border-brand-dark focus:outline-none"
            >
              <option value="all">All Categories</option>
              {categories.map((cat) => (
                <option value={cat}>{cat}</option>
              ))}
            </select>
          </div>

          <!-- Size Filter -->
          <div>
            <label for="filter-size" class="block text-[11px] font-mono uppercase font-bold text-brand-charcoal/80 mb-1">
              Size
            </label>
            <select
              id="filter-size"
              class="w-full text-xs font-mono bg-brand-surface border border-brand-border px-3 py-2.5 focus:border-brand-dark focus:outline-none"
            >
              <option value="all">All Sizes</option>
              {sizes.map((s) => (
                <option value={s}>Size {s}</option>
              ))}
            </select>
          </div>

          <!-- Price Range Filter -->
          <div>
            <label for="filter-price" class="block text-[11px] font-mono uppercase font-bold text-brand-charcoal/80 mb-1">
              Price Range
            </label>
            <select
              id="filter-price"
              class="w-full text-xs font-mono bg-brand-surface border border-brand-border px-3 py-2.5 focus:border-brand-dark focus:outline-none"
            >
              <option value="all">All Prices</option>
              <option value="under-1500">Under ₹1,500</option>
              <option value="1500-2500">₹1,500 – ₹2,500</option>
              <option value="above-2500">Above ₹2,500</option>
            </select>
          </div>

          <!-- Availability Filter -->
          <div>
            <label for="filter-status" class="block text-[11px] font-mono uppercase font-bold text-brand-charcoal/80 mb-1">
              Availability
            </label>
            <select
              id="filter-status"
              class="w-full text-xs font-mono bg-brand-surface border border-brand-border px-3 py-2.5 focus:border-brand-dark focus:outline-none"
            >
              <option value="all">All Items</option>
              <option value="available">Available Now</option>
              <option value="sold">Sold Out Archives</option>
            </select>
          </div>

          <!-- Sorting -->
          <div class="col-span-2 sm:col-span-2 md:col-span-4 lg:col-span-1">
            <label for="sort-by" class="block text-[11px] font-mono uppercase font-bold text-brand-charcoal/80 mb-1">
              Sort By
            </label>
            <select
              id="sort-by"
              class="w-full text-xs font-mono bg-brand-surface border border-brand-border px-3 py-2.5 focus:border-brand-dark focus:outline-none font-bold"
            >
              <option value="newest">Latest Drops</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
            </select>
          </div>

        </div>

        <!-- Filter Action Row -->
        <div class="flex items-center justify-between pt-3 border-t border-brand-border/70 text-xs font-mono">
          <div class="flex items-center gap-2">
            <span class="text-brand-charcoal/60 uppercase">Active:</span>
            <span id="active-filter-summary" class="text-brand-accent font-bold">All pieces</span>
          </div>
          <button
            id="clear-filters-btn"
            type="button"
            class="text-xs uppercase tracking-wider text-brand-charcoal/80 hover:text-brand-accent underline underline-offset-4 focus:outline-none font-bold"
          >
            Clear All Filters
          </button>
        </div>

      </div>
    </div>

    <!-- Loading Skeleton Placeholder (Toggled via JS) -->
    <div id="filter-skeleton" class="hidden grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
      {Array.from({ length: 4 }).map(() => (
        <div class="border border-brand-border bg-white/60 p-4 animate-pulse space-y-3">
          <div class="aspect-[4/5] bg-stone-300"></div>
          <div class="h-4 bg-stone-300 w-3/4"></div>
          <div class="h-4 bg-stone-300 w-1/2"></div>
        </div>
      ))}
    </div>

    <!-- Product Grid: 2 columns on mobile, 3 on tablet, 4 on desktop -->
    <div
      id="product-grid"
      class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6"
    >
      {products.map((product, idx) => (
        <ProductCard product={product} priority={idx < 4} />
      ))}
    </div>

    <!-- Empty State -->
    <EmptyState id="shop-empty-state" />

  </div>

  <Footer slot="footer" />
  <FloatingWhatsApp slot="floating" />
</BaseLayout>

<script>
  function initShopFilters() {
    const grid = document.getElementById('product-grid');
    const skeleton = document.getElementById('filter-skeleton');
    const emptyState = document.getElementById('shop-empty-state');
    const resetEmptyBtn = document.getElementById('empty-state-reset');
    const clearBtn = document.getElementById('clear-filters-btn');
    const visibleCountEl = document.getElementById('visible-count');
    const activeSummaryEl = document.getElementById('active-filter-summary');

    const catSelect = document.getElementById('filter-category') as HTMLSelectElement | null;
    const sizeSelect = document.getElementById('filter-size') as HTMLSelectElement | null;
    const priceSelect = document.getElementById('filter-price') as HTMLSelectElement | null;
    const statusSelect = document.getElementById('filter-status') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('sort-by') as HTMLSelectElement | null;

    if (!grid || !catSelect || !sizeSelect || !priceSelect || !statusSelect || !sortSelect) return;

    // Check query params on load (e.g. ?category=Jackets)
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('category');
    if (categoryParam && catSelect.querySelector(`option[value="${categoryParam}"]`)) {
      catSelect.value = categoryParam;
    }

    function applyFilters() {
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll('.product-card')) as HTMLElement[];

      const selectedCat = catSelect?.value || 'all';
      const selectedSize = sizeSelect?.value || 'all';
      const selectedPrice = priceSelect?.value || 'all';
      const selectedStatus = statusSelect?.value || 'all';
      const selectedSort = sortSelect?.value || 'newest';

      let visibleCount = 0;

      // Filter
      cards.forEach((card) => {
        const cat = card.dataset.category || '';
        const size = card.dataset.size || '';
        const price = Number(card.dataset.price || '0');
        const status = card.dataset.status || '';

        let matchCat = selectedCat === 'all' || cat === selectedCat;
        let matchSize = selectedSize === 'all' || size === selectedSize;
        let matchStatus = selectedStatus === 'all' || status === selectedStatus;
        
        let matchPrice = true;
        if (selectedPrice === 'under-1500') {
          matchPrice = price < 1500;
        } else if (selectedPrice === '1500-2500') {
          matchPrice = price >= 1500 && price <= 2500;
        } else if (selectedPrice === 'above-2500') {
          matchPrice = price > 2500;
        }

        const isVisible = matchCat && matchSize && matchPrice && matchStatus;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visibleCount++;
      });

      // Sort
      const sortedCards = [...cards].sort((a, b) => {
        const priceA = Number(a.dataset.price || 0);
        const priceB = Number(b.dataset.price || 0);
        const dateA = a.dataset.date || '';
        const dateB = b.dataset.date || '';

        if (selectedSort === 'price-asc') {
          return priceA - priceB;
        } else if (selectedSort === 'price-desc') {
          return priceB - priceA;
        } else {
          // newest
          return dateB.localeCompare(dateA);
        }
      });

      sortedCards.forEach((card) => grid.appendChild(card));

      // Update counters & states
      if (visibleCountEl) {
        visibleCountEl.textContent = String(visibleCount);
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          grid.classList.add('hidden');
        } else {
          emptyState.classList.add('hidden');
          grid.classList.remove('hidden');
        }
      }

      // Update active summary text
      const summaryParts = [];
      if (selectedCat !== 'all') summaryParts.push(selectedCat);
      if (selectedSize !== 'all') summaryParts.push(`Size ${selectedSize}`);
      if (selectedPrice !== 'all') summaryParts.push(selectedPrice.replace('-', ' '));
      if (selectedStatus !== 'all') summaryParts.push(selectedStatus === 'available' ? 'Available' : 'Sold Out');

      if (activeSummaryEl) {
        activeSummaryEl.textContent = summaryParts.length ? summaryParts.join(' • ') : 'All pieces';
      }
    }

    function resetFilters() {
      if (catSelect) catSelect.value = 'all';
      if (sizeSelect) sizeSelect.value = 'all';
      if (priceSelect) priceSelect.value = 'all';
      if (statusSelect) statusSelect.value = 'all';
      if (sortSelect) sortSelect.value = 'newest';
      applyFilters();
    }

    [catSelect, sizeSelect, priceSelect, statusSelect, sortSelect].forEach((el) => {
      el?.addEventListener('change', applyFilters);
    });

    clearBtn?.addEventListener('click', resetFilters);
    resetEmptyBtn?.addEventListener('click', resetFilters);

    // Initial pass
    applyFilters();
  }

  initShopFilters();
  document.addEventListener('astro:page-load', initShopFilters);
</script>

---
import type { Product } from '../../types/product';
import { formatINR, getConditionBadgeClass } from '../../utils/formatters';
import SoldOutBadge from './SoldOutBadge.astro';

export interface Props {
  product: Product;
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const isSold = product.status === 'sold';
const activePrice = product.offerPrice ?? product.price;
const hasOffer = typeof product.offerPrice === 'number' && product.offerPrice < product.price;
---

<article
  class="product-card group flex flex-col justify-between border border-brand-border bg-white transition-all duration-300 hover:border-brand-dark hover:shadow-md relative"
  data-category={product.category}
  data-size={product.size}
  data-price={activePrice}
  data-status={product.status}
  data-date={product.dateAdded}
  data-code={product.code}
  data-name={product.name.toLowerCase()}
>
  <!-- Card Top Media & Badges -->
  <div>
    <div class="relative aspect-[4/5] bg-stone-900 overflow-hidden">
      <!-- Product Image -->
      <a href={`/shop/${product.slug}`} class="block w-full h-full focus:outline-none focus:ring-2 focus:ring-brand-accent">
        <img
          src={product.images[0]}
          alt={`${product.name} - ${product.code}`}
          class={`w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 ${
            isSold ? 'opacity-55 grayscale-[35%]' : ''
          }`}
          loading={priority ? 'eager' : 'lazy'}
          width="400"
          height="500"
        />
      </a>

      <!-- Badges on Top Left & Right -->
      <div class="absolute top-2.5 left-2.5 flex flex-col gap-1.5 z-10">
        <span class="font-mono text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 bg-brand-dark text-white border border-neutral-700">
          {product.code}
        </span>
        {hasOffer && !isSold && (
          <span class="font-mono text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 bg-brand-accent text-white">
            SALE
          </span>
        )}
      </div>

      <div class="absolute top-2.5 right-2.5 z-10">
        {isSold ? (
          <SoldOutBadge size="sm" variant="badge" />
        ) : (
          <span class={`font-mono text-[10px] uppercase tracking-wider px-2 py-0.5 border ${getConditionBadgeClass(product.condition)}`}>
            {product.condition}
          </span>
        )}
      </div>

      <!-- Sold Out Center Watermark -->
      {isSold && (
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="bg-brand-dark/85 backdrop-blur-sm border border-stone-600 px-4 py-2 transform -rotate-3 text-center">
            <span class="font-display text-lg uppercase tracking-widest text-stone-200">
              SOLD OUT
            </span>
          </div>
        </div>
      )}
    </div>

    <!-- Details Section -->
    <div class="p-3.5 sm:p-4">
      <!-- Category & Size Pill -->
      <div class="flex items-center justify-between text-xs font-mono text-brand-charcoal/70 mb-1.5">
        <span class="uppercase tracking-wider">{product.category}</span>
        <span class="font-bold text-brand-dark bg-brand-muted px-2 py-0.5 text-[11px]">
          SIZE {product.size}
        </span>
      </div>

      <!-- Name -->
      <h3 class="font-display text-lg sm:text-xl uppercase tracking-tight text-brand-dark group-hover:text-brand-accent transition-colors line-clamp-1">
        <a href={`/shop/${product.slug}`} class="focus:outline-none focus:underline">
          {product.name}
        </a>
      </h3>

      <!-- Price -->
      <div class="mt-2 flex items-baseline gap-2">
        <span class="font-display text-xl sm:text-2xl text-brand-dark">
          {formatINR(activePrice)}
        </span>
        {hasOffer && (
          <span class="text-xs sm:text-sm line-through text-brand-sold font-mono">
            {formatINR(product.price)}
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- Bottom Action Button -->
  <div class="p-3.5 sm:p-4 pt-0">
    <a
      href={`/shop/${product.slug}`}
      class={`w-full py-2.5 px-3 flex items-center justify-center gap-1.5 text-xs font-mono uppercase tracking-wider font-semibold transition-all duration-200 ${
        isSold
          ? 'bg-stone-200 text-stone-600 hover:bg-stone-300'
          : 'bg-brand-dark text-brand-surface hover:bg-brand-accent'
      }`}
    >
      <span>{isSold ? 'View Archive' : 'View Piece'}</span>
      <span class="text-[10px]">→</span>
    </a>
  </div>
</article>
